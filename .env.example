# Copia este archivo a .env y completa los valores reales. .env nunca se sube a git.
# Por defecto el proyecto funciona SIN este archivo: LLM_BACKEND=fake no necesita
# ninguna variable de entorno ni hace llamadas reales a Anthropic.

# "fake" (default): cliente simulado local, sin red, sin coste.
# "anthropic": usa la API real — requiere ANTHROPIC_API_KEY.
LLM_BACKEND=fake

# Solo necesaria si LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# Modelo a usar cuando LLM_BACKEND=anthropic. claude-sonnet-5 es más barato/rápido
# para desarrollo; usa claude-opus-5 cuando necesites más capacidad de razonamiento.
MODEL_NAME=claude-sonnet-5

# Número máximo de iteraciones del bucle de tool use antes de abortar.
MAX_TOOL_ITERATIONS=10

# Orígenes permitidos por CORS para el frontend (nunca "*"). En desarrollo,
# los puertos que Next.js suele usar; en producción, el dominio real del frontend.
# Formato: JSON. Ejemplo: CORS_ALLOWED_ORIGINS=["https://mi-dominio.com"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]

# Workspace de solo lectura para las tools list_files/read_file (relativo al directorio
# de trabajo). El agente solo puede ver lo que haya dentro de esta carpeta.
WORKSPACE_ROOT=workspace
# Máximo de bytes que devuelve read_file (si el archivo es mayor, truncated=true).
WORKSPACE_MAX_READ_BYTES=65536
# Máximo de archivos que devuelve list_files.
WORKSPACE_MAX_LIST_ENTRIES=200
# Extensiones permitidas (JSON). Nunca añadas .env ni claves privadas.
WORKSPACE_ALLOWED_EXTENSIONS=[".txt",".md",".json",".csv"]
