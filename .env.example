# Copia este archivo a .env y completa los valores reales. .env nunca se sube a git.
# Por defecto el proyecto funciona SIN este archivo: LLM_BACKEND=fake no necesita
# ninguna variable de entorno ni hace llamadas reales a Anthropic.

# "fake" (default): cliente simulado local, sin red, sin coste.
# "anthropic": usa la API real — requiere ANTHROPIC_API_KEY.
LLM_BACKEND=fake

# Solo necesaria si LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=

# Modelo a usar cuando LLM_BACKEND=anthropic. claude-sonnet-5 es más barato/rápido
# para desarrollo; usa claude-opus-5 cuando necesites más capacidad de razonamiento.
MODEL_NAME=claude-sonnet-5

# Número máximo de iteraciones del bucle de tool use antes de abortar.
MAX_TOOL_ITERATIONS=10
